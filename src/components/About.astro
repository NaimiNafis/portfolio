---
import type { Link } from '../data/projects';

const devtech: Link = { label: 'DevTech.Pro', href: 'https://devtech.pro/en' };
const isel: Link = { label: 'KIT-ISEL', href: 'https://kit-isel.github.io/member/' };
const kit: Link = { label: 'Kyoto Institute of Technology', href: 'https://www.kit.ac.jp/' };

interface Row {
  role: string;
  orgs: Link[];
  note?: string;
  dates: string;
}

const experience: Row[] = [
  {
    role: 'Software Engineer',
    orgs: [devtech],
    note: 'student employee, remote',
    dates: 'Jun 2026 – Present',
  },
  {
    role: 'Graduate Researcher',
    orgs: [isel, kit],
    dates: 'Apr 2025 – Present',
  },
  { role: 'M.S. Computer Science & Engineering', orgs: [kit], dates: 'Apr 2026 – Mar 2028' },
  { role: 'B.Eng. Information Science', orgs: [kit], dates: 'Apr 2022 – Mar 2026' },
];

---

<section id="about">
  <h2>About</h2>
  <ul class="rows">
    {
      experience.map((item) => (
        <li>
          <span class="dates">{item.dates}</span>
          <div>
            <h3>{item.role}</h3>
            <p class="place">
              {item.orgs.map((org, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={org.href} target="_blank" rel="noopener">
                    {org.label}
                  </a>
                </>
              ))}
              {item.note && ` · ${item.note}`}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
  <details>
    <summary>More about me</summary>
    <p>
      I build backend and frontend features for production SaaS at{' '}
      <a href="https://devtech.pro/en" target="_blank" rel="noopener">DevTech.Pro</a> (Go, Python, React) and research
      LLM-generated code detection at{' '}
      <a href="https://www.kit.ac.jp/" target="_blank" rel="noopener">Kyoto Institute of Technology</a>. I am learning to build AI agents, starting with the first agent use
      case on my team.
    </p>
    <p lang="ja">
      京都を拠点とするフルスタックエンジニアです。京都工芸繊維大学大学院でLLMが生成したコードの検出を研究しながら、DevTech.ProではGo・Python・Reactを用いたSaaS開発を担当しています。現在はチームで初めてのAIエージェント開発を任され、必要な技術を学んでいるところです。
    </p>
  </details>
</section>


<style>
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .rows > li {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 0.25rem 2rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .dates {
    font-weight: 600;
    color: var(--muted);
  }
  h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
  }
  p {
    margin: 0.25rem 0 0;
    color: var(--muted);
  }
  .place {
    color: var(--ink);
  }

  details {
    margin-top: 1.5rem;
    max-width: 48rem;
  }
  summary {
    width: fit-content;
    font-weight: 600;
    cursor: pointer;
  }
  details > p {
    margin-top: 1rem;
  }

  @media (max-width: 640px) {
    .rows > li {
      grid-template-columns: 1fr;
    }
  }
</style>
