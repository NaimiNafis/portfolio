---
import type { Link } from '../data/projects';

const devtech: Link = { label: 'DevTech.Pro', href: 'https://devtech.pro/en' };
const isel: Link = { label: 'KIT-ISEL', href: 'https://kit-isel.github.io/member/' };
const kit: Link = { label: 'Kyoto Institute of Technology', href: 'https://www.kit.ac.jp/' };

interface Row {
  role: string;
  orgs: Link[];
  note?: string;
  dates: string;
  line?: string;
}

const experience: Row[] = [
  {
    role: 'Software Engineer',
    orgs: [devtech],
    note: 'part-time, remote',
    dates: 'Jun 2026 – Present',
    line: 'Public Chrome Web Store launch and CI/CD for MightClick. Trip wizard, heat map, live-fleet redesign and one aggregation endpoint for Cooriroo.',
  },
  {
    role: 'Graduate Researcher',
    orgs: [isel, kit],
    dates: 'Apr 2025 – Present',
    line: 'Detecting LLM-generated code. Built the lab attendance system and a Dockerised benchmark for three detectors.',
  },
  { role: 'M.S. Computer Science & Engineering', orgs: [kit], dates: 'Apr 2026 – Mar 2028' },
  { role: 'B.Eng. Information Science', orgs: [kit], dates: 'Apr 2022 – Mar 2026' },
];

---

<section id="about">
  <h2>About</h2>
  <ul>
    {
      experience.map((item) => (
        <li>
          <span class="dates">{item.dates}</span>
          <div>
            <h3>{item.role}</h3>
            <p class="place">
              {item.orgs.map((org, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={org.href} target="_blank" rel="noopener">
                    {org.label}
                  </a>
                </>
              ))}
              {item.note && ` · ${item.note}`}
            </p>
            {item.line && <p>{item.line}</p>}
          </div>
        </li>
      ))
    }
  </ul>
</section>


<style>
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 0.25rem 2rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .dates {
    font-weight: 600;
    color: var(--muted);
  }
  h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
  }
  p {
    margin: 0.25rem 0 0;
    color: var(--muted);
  }
  .place {
    color: var(--ink);
  }

  @media (max-width: 640px) {
    li {
      grid-template-columns: 1fr;
    }
  }
</style>
