---
import { Image } from 'astro:assets';
import Socials from './Socials.astro';
import profile from '../assets/profile.png';

const base = import.meta.env.BASE_URL;
---

<section class="hero" id="top">
  <div class="intro">
    <h1>Hi, I'm Naimi</h1>
    <p class="lede">Full-stack engineer in Kyoto, building AI agents.</p>
    <dl>
      <div>
        <dt>Currently</dt>
        <dd>
          <a href="https://devtech.pro/en" target="_blank" rel="noopener">DevTech.Pro</a>{' · '}
          <a href="https://kit-isel.github.io/member/" target="_blank" rel="noopener">KIT-ISEL</a>
        </dd>
      </div>
      <div>
        <dt>Education</dt>
        <dd>M.S. <a href="https://www.kit.ac.jp/" target="_blank" rel="noopener">KIT</a>, 2028</dd>
      </div>
    </dl>
  </div>

  <aside>
    <div class="avatar">
      <Image class="photo" src={profile} alt="Naimi Nafis" width={800} loading="eager" />
      <img class="drawing" src={`${base}me.png`} alt="" width="256" height="256" />
    </div>
    <p>
      I build backend and frontend features for production SaaS at{' '}
      <a href="https://devtech.pro/en" target="_blank" rel="noopener">DevTech.Pro</a> (Go, Python, React) and research
      LLM-generated code detection at{' '}
      <a href="https://www.kit.ac.jp/" target="_blank" rel="noopener">Kyoto Institute of Technology</a>. Currently specialising in AI agents with Google ADK and A2A.
    </p>
    <p lang="ja">
      京都を拠点とするフルスタックエンジニアです。DevTech.ProでGo・Python・Reactを使ったSaaS開発に携わりながら、京都工芸繊維大学でLLMが生成したコードの検出を研究しています。日本語（JLPT
      N2）と英語で仕事ができます。
    </p>
    <Socials />
  </aside>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: clamp(2rem, 4vw, 3rem);
    padding-block: clamp(2rem, 6vw, 4rem);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.75rem, 7vw, 5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .lede {
    margin: 0.5rem 0 0;
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--muted);
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1.5rem;
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
  }
  dt {
    font-weight: 700;
    font-size: 1.25rem;
  }
  dd {
    margin: 0.25rem 0 0;
    font-size: 1.25rem;
    color: var(--muted);
  }
  aside {
    padding-left: clamp(2rem, 4vw, 3rem);
    border-left: 1px solid var(--line);
  }
  /* Photo slowly fades into the drawing on hover. */
  .avatar {
    position: relative;
    width: 11rem;
    height: 11rem;
    border-radius: 50%;
    overflow: clip;
  }
  /* Crop knob: a 680px square around the face (centre 785, 930) of the 1536x2048 photo. */
  .avatar :global(.photo) {
    position: absolute;
    width: 226%;
    max-width: none;
    height: auto;
    left: -65.4%;
    top: -86.8%;
    transition: opacity 0.8s ease;
  }
  .avatar:hover :global(.photo) {
    opacity: 0;
  }
  .drawing {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .avatar:hover .drawing {
    opacity: 1;
  }
  aside p {
    margin: 1rem 0 0;
    font-size: 1.15rem;
    color: var(--muted);
  }
  aside :global(.socials) {
    margin-top: 1.5rem;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }
    aside {
      padding-left: 0;
      padding-top: 2rem;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
