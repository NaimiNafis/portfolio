---
import { Image } from 'astro:assets';
import Socials from './Socials.astro';
import profile from '../assets/profile.png';

const base = import.meta.env.BASE_URL;
---

<section class="hero" id="top">
  <div class="intro">
    <h1>Hi, I'm Naimi</h1>
    <p class="lede">Software engineer and Graduate researcher in Kyoto, Japan.</p>
  </div>

  <aside>
    <button type="button" class="avatar" aria-pressed="false" aria-label="Naimi Nafis: switch between photo and drawing">
      <Image class="photo" src={profile} alt="" width={800} loading="eager" />
      <img class="drawing" src={`${base}me.png`} alt="" width="256" height="256" />
    </button>
    <Socials />
  </aside>
</section>

<script>
  const avatar = document.querySelector<HTMLButtonElement>('.avatar');
  avatar?.addEventListener('click', () => {
    avatar.setAttribute('aria-pressed', String(avatar.getAttribute('aria-pressed') !== 'true'));
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: clamp(2rem, 4vw, 3rem);
    padding-block: clamp(2rem, 6vw, 4rem);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.75rem, 7vw, 5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .lede {
    margin: 0.5rem 0 0;
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--muted);
  }
  aside {
    padding-left: clamp(2rem, 4vw, 3rem);
    border-left: 1px solid var(--line);
  }
  /* Photo fades into the drawing: on hover with a mouse, or tap to toggle on touch screens. */
  .avatar {
    position: relative;
    display: block;
    width: 11rem;
    height: 11rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    overflow: clip;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .avatar:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }
  /* Crop knob: a 680px square around the face (centre 785, 930) of the 1536x2048 photo. */
  .avatar :global(.photo) {
    position: absolute;
    width: 226%;
    max-width: none;
    height: auto;
    left: -65.4%;
    top: -86.8%;
    transition: opacity 0.8s ease;
  }
  .drawing {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .avatar[aria-pressed='true'] :global(.photo) {
    opacity: 0;
  }
  .avatar[aria-pressed='true'] .drawing {
    opacity: 1;
  }
  /* Touch screens fake a sticky :hover after a tap, so hover only counts with a real pointer. */
  @media (hover: hover) {
    .avatar:hover :global(.photo) {
      opacity: 0;
    }
    .avatar:hover .drawing {
      opacity: 1;
    }
  }
  aside :global(.socials) {
    margin-top: 1.5rem;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }
    aside {
      padding-left: 0;
      padding-top: 2rem;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
