---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.{png,jpg,jpeg,webp}', {
  eager: true,
});
const image = Object.entries(images).find(([path]) => path.split('/').pop()?.split('.')[0] === project.slug)?.[1];
---

<article style={`--color: ${project.color}`}>
  <div class="frame">
    {
      image ? (
        <Image src={image.default} alt={`Screenshot of ${project.title}`} width={880} />
      ) : (
        <span class="tile" aria-hidden="true">
          {project.title}
        </span>
      )
    }
  </div>
  <h3>
    {
      project.href ? (
        <a class="main" href={project.href} target="_blank" rel="noopener">
          {project.title}
        </a>
      ) : (
        project.title
      )
    }
    <span class="tag">
      {project.tag}
      {project.href && <span aria-hidden="true"> ↗</span>}
    </span>
  </h3>
  <p>{project.description}</p>
  {
    project.repo && (
      <a class="repo" href={project.repo} target="_blank" rel="noopener">
        Code on GitHub ↗
      </a>
    )
  }
  <p class="meta">{project.meta}</p>
</article>

<style>
  article {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  article:has(.main:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 6px;
    border-radius: 12px;
  }
  .frame {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    aspect-ratio: 16 / 10;
    padding: 8% 8% 0;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color);
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    border-radius: 8px 8px 0 0;
    transition: transform 0.3s ease;
  }
  article:hover .frame :global(img) {
    transform: translateY(-4px);
  }
  .tile {
    align-self: center;
    margin-bottom: 8%;
    text-align: center;
    color: #fff;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
  }
  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 1.25rem 0 0;
    font-size: 1.6rem;
    font-weight: 700;
  }
  .main {
    color: inherit;
    text-decoration: none;
  }
  /* Whole card is clickable; the repo link sits above this overlay. */
  .main::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .main:focus-visible {
    outline: none;
  }
  .tag {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  p {
    margin: 0.6rem 0 0;
    font-size: 1.05rem;
    color: var(--muted);
  }
  .repo {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    margin-top: 0.5rem;
    font-weight: 600;
    color: var(--ink);
  }
  .meta {
    margin-top: auto;
    padding-top: 0.75rem;
    font-weight: 600;
    color: var(--ink);
  }
</style>
