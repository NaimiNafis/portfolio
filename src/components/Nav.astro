---
const base = import.meta.env.BASE_URL;
---

<header>
  <a class="logo" href="#top" aria-label="Naimi Nafis, back to top">
    <img src={`${base}me.png`} alt="" width="48" height="48" />
  </a>
  <nav aria-label="Main">
    <a class="pill" href="#work">Work</a>
    <a class="pill" href="#about">About</a>
    <a class="pill" href={`${base}resume.pdf`} target="_blank" rel="noopener">Resume</a>
  </nav>
</header>

<script>
  // Slow, eased scroll to in-page sections. Respects the OS "reduce motion" setting (then it jumps).
  const DURATION = 900;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const ease = (t: number) => (t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2);

  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const target = document.querySelector<HTMLElement>(link.hash);
      if (!target || reduceMotion.matches) return;
      event.preventDefault();
      const start = window.scrollY;
      const margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
      const end = Math.max(0, target.getBoundingClientRect().top + start - margin);
      const t0 = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / DURATION);
        window.scrollTo(0, start + (end - start) * ease(t));
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
      history.pushState(null, '', link.hash);
    });
  });
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.25rem;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .logo {
    display: block;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--line);
  }
  .logo img {
    display: block;
    width: 100%;
    height: 100%;
  }
  nav {
    display: flex;
    gap: 0.25rem;
  }
  .pill {
    padding: 0.55rem 1rem;
    border-radius: 999px;
    color: var(--muted);
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
  }
  .pill:hover {
    background: var(--hover);
    color: var(--ink);
  }
</style>
