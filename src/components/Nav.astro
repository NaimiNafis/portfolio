---
const base = import.meta.env.BASE_URL;
---

<header>
  <a class="logo" href="#top" aria-label="Naimi Nafis, back to top">NN</a>
  <nav aria-label="Main">
    <a class="pill" href="#work">Work</a>
    <a class="pill" href="#about">About</a>
    <a class="pill" href={`${base}resume.pdf`} target="_blank" rel="noopener">Resume</a>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.25rem;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .logo {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    font-weight: 800;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 0.25rem;
  }
  .pill {
    padding: 0.55rem 1rem;
    border-radius: 999px;
    color: var(--muted);
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
  }
  .pill:hover {
    background: var(--hover);
    color: var(--ink);
  }
</style>
